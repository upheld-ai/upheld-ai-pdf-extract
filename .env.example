# Upheld AI PDF Extract - Environment Configuration

# Authentication
# Secret API token for Bearer and X-API-Token authentication (comma-separated for key rotation)
API_TOKEN=your-production-secret-token-here

# Server Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8020
REQUEST_TIMEOUT_SECONDS=120
WEB_CONCURRENCY=4

# Guardrails & Safety Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES=500

# Rendering & Quality Defaults
DEFAULT_RENDER_DPI=150
MAX_RENDER_DPI=300
DEFAULT_IMAGE_FORMAT=png

# Document Intelligence Heuristics
# Pages with fewer characters than this threshold will be flagged as scanned/sparse
SCANNED_THRESHOLD_CHARS=100

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
